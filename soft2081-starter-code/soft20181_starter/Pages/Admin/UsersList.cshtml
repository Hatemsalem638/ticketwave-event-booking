@page
@model soft20181_starter.Pages.Admin.UsersListModel
@{
}

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<h1>Users List</h1>

<div class="container">
    <ul class="list-group">
        @foreach (var SignUpDetails in Model.SignUpDetailsList)
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between align-items-center">
                    <span>@SignUpDetails.FirstName - @SignUpDetails.LastName</span>
                    <div>
                        <a class="btn btn-primary" asp-page="EditUsers" asp-route-id="@SignUpDetails.Id">Edit</a>
                        <a class="btn btn-danger" asp-page="EditUsers" asp-route-id="@SignUpDetails.Id" asp-page-handler="Delete">Delete</a>
                    </div>
                </div>
                <div class="mt-2">
                    <p><strong>Phone Number:</strong> @SignUpDetails.PhoneNumber</p>
                    <p><strong>Gender:</strong> @SignUpDetails.Gender</p>
                    <p><strong>Email:</strong> @SignUpDetails.Email</p>
                    <p><strong>Password:</strong> @SignUpDetails.Password</p>
                    <p><strong>Date of Birth:</strong> @SignUpDetails.DateOfBirth</p>
                </div>
            </li>
        }
    </ul>
</div>
