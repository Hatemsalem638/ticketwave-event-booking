@page
@model soft20181_starter.Pages.CartModel
@{
}


<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/Cart.css">


<nav>
    <div class="logo"><a href="index"><img src="~/css/ticketwave-high-resolution-logo-white-transparent.png" alt="Logo" width="100" height="50"></a></div>
    <div class="hamburger">
        <div class="line"></div>
        <div class="line"></div>
        <div class="line"></div>
    </div>
    <ul class="menu">
        <li><a href="index" class="active">Home</a></li>
        <li><a href="Events">Events</a></li>
        <li><a href="About Us">About</a></li>
        <li><a href="Contactus">Contact us</a></li>
    </ul>
    <div class="Search">
        <form>
            <input type="text" placeholder="Search........">
            <button type="submit">Go</button>
        </form>
    </div>

    <img src="~/css/sun 6.png" id="icon">
</nav>

<body>
    <div class="attendance-list">
        <h1>Cart</h1>
    </div>

    <div class="container">
        @if (Model.CartItems.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-custom">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Event Ticket</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td>@item.FirstName @item.LastName</td>
                                <td>@item.EventTicket</td>
                                <td>
                                    <a class="btn btn-danger" asp-page="Cart" asp-page-handler="Delete" asp-route-id="@item.Id">Remove</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-center">
                <a class="btn btn-primary btn-custom-generate" asp-page="Ticket">Generate Ticket</a>
            </div>
            <div class="text-center">
                <a class="btn btn-primary btn-checkout" asp-page="Thankyou">Check Out</a>
            </div>

        }
        else
        {
            <p>Your Cart is empty.</p>
        }
    </div>
</body>