@page
@model soft20181_starter.Pages.Dave_concertModel
@{
}


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/sEvents.css">
    <title>Your Webpage Title</title>
</head>
<body>

    <nav>
        <div class="logo"><a href="index"><img src="~/css/ticketwave-high-resolution-logo-white-transparent.png" alt="Logo" width="100" height="50"></a></div>
        <div class="hamburger">
            <div class="line"></div>
            <div class="line"></div>
            <div class="line"></div>
        </div>
        <ul class="menu">
            <li><a href="index" class="active">Home</a></li>
            <li><a href="Events">Events</a></li>
            <li><a href="About Us">About</a></li>
            <li><a href="Contactus">Contact us</a></li>
        </ul>
        <div class="Search">
            <form>
                <input type="text" placeholder="Search........">
                <button type="submit">Go</button>
            </form>
        </div>

        <img src="~/css/sun 6.png" id="icon">
    </nav>

    <div class="main-content">
        <div class="image-container">
            <img src="~/css/Dave wp.jpg" alt="">
        </div>
        <div class="text-content">
            <h2>@Model.TheeventList?.EventName</h2>
            <h3>Match Day</h3>
            <p>@Model.TheeventList?.Day</p>
            <h3>This RIVALRY</h3>
            <p>@Model.TheeventList?.Description</p>
            <h3>Venue</h3>
            <p>@Model.TheeventList?.Venue</p>
            <h3>Competition</h3>
            <p>@Model.TheeventList?.Title</p>

            <h3>Booking</h3>
            <div class="image-container">
                <img class="stadium-image" src="~/css/Concert 1.0.png" alt="">
                <div class="ticket-buttons">
                    <a href="CheckoutPage">
                        <button>BuyNow</button>
                    </a>
                </div>
            </div>
        </div>
    </div>


    <h2 class="sheading">Other Events:</h2>

    <h4 class="oEvents">
        <div class="box"><h2><a href="Liverpool vs Manchester United"><img src="~/css/Liverpool-vs-Manchester-United-min.jpg" alt=""></h2></a></div>
        <div class="box"><h2><a href="Cavaliers vs Knicks"><img src="~/css/Cavaliers vs Knicks.jpg" alt=""></h2></a></div>
        <div class="box"><h2><a href="Central Cee Concert"><img src="~/css/central cee wp.jpg" alt=""></h2></a></div>
        <div class="box"><h2><a href="Barcelona vs Atletico Madrid"><img src="~/css/Barcelona vs atletico.jpg" alt=""></h2></a></div>
        <div class="box"><h2><a href="PSG vs AC Milan"><img src="~/css/PSG-vs-Milan.jpg" alt=""></h2></a></div>
        <div class="box"><h2><a href="Isle of Wight"><img src="~/css/isle 2024.jpg" alt=""></h2></a></div>
        <div class="box"><h2><a href="Lakers vs magic"><img src="~/css/Lakers vs magic.jpg" alt=""></h2></a></div>
        <div class="box"><h2><a href="Real Madrid vs Napoli"><img src="~/css/Madrid vs napoli.jpg" alt=""></h2></a></div>
        <div class="box"><h2><a href="The weeknd"><img src="~/css/weeknd.jpg" alt=""></h2></a></div>


    </h4>

    <script src="~/js/site.js"></script>



    <footer>
        <p>&copy; 2024 Ticket Wave. All rights reserved.</p>
    </footer>
</body>
</html>
