INSERT INTO EventsTable (EventName, Description, Day, Venue, Title, imageurl)
VALUES ('Isle of Wight Festival', 'About the Event Unforgettable experiences are always assured at the Isle of Wight Festival. It involves walking side by side with other festival attendees. It involves cheering as the fireworks light up the sky and watching the sun set over the Main Stage. Its celebrating more than half a century of music history and finding amazing new musicians. Its taking in the naturally enchanted atmosphere of the island. Its creating lifelong friendships and enduring memories.', 'Friday-Saturday-Sunday, 20-23 June 2024, 20:00', 'Seaclose Park, Isle of Wight, United Kingdom', 'Festival', 'url_for_image');

-- The Weeknd Concert
INSERT INTO EventsTable (EventName, Description, Day, Venue, Title, imageurl)
VALUES ('The Weeknd Concert', 'About the Concert Take in The Weeknds incredible performance, which combines captivating beats and soulful melodies to create a memorable musical experience. With a unique blend of entertainment and artistry, this concert promises to be an incredible experience, something that only The Weeknd can provide.', 'Friday, 10 March 2024, 20:00', 'City Stadium Arena, Your City', 'Spectacular Live Performance by The Weeknd', 'url_for_image');

-- Central Cee Concert
INSERT INTO EventsTable (EventName, Description, Day, Venue, Title, imageurl)
VALUES ('Central Cee Concert', 'About the Concert Dont miss the electrifying performance by Central Cee, where raw lyrics and infectious beats come to life. Experience the energy of his music as he takes the stage for an unforgettable night of rap and hip-hop vibes.', 'Sunday 31 December 2024, 10:00', 'Rna Brisbane Showgrounds - Main Arena, Bowen Hills, QLD, Australia', 'Live Concert by Central Cee', 'url_for_image');

-- Dave Concert
INSERT INTO EventsTable (EventName, Description, Day, Venue, Title, imageurl)
VALUES ('Dave Concert', 'About the Concert Experience the genre-bending live performance of Dave, a lyrical mastermind who commands attention. A night of musical genius that captures the spirit of Daves distinct artistry is promised at this concert, which will feature both thought-provoking verses and upbeat beats.', 'Tuesday, 15 March 2024, 20:00', 'Parc des Princes, Paris, France', 'Spectacular Live Performance by Dave', 'url_for_image');
</sql><current_tab id="0"/></tab_sql></sqlb_project>
